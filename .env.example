# Copy to .env.local and fill in. Never commit the filled version.

# Pooled connection (pgBouncer) — used by the app at runtime.
DATABASE_URL=

# Direct connection — used by `prisma migrate`. Migrations cannot run
# through the pooler. In Neon this is the "unpooled" connection string.
DIRECT_URL=

# Random 32+ byte secret for signing session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
