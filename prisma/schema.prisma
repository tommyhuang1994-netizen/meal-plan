// Zera meal plan — data model
// Money is Decimal(10,2) everywhere. Never Float.

// prisma-client-js (not the newer prisma-client) because this project is plain
// JavaScript: the newer generator emits TypeScript sources, which `node` cannot
// import directly in the seed script. This one emits JS and is importable from
// "@prisma/client".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  PARENT
  ADMIN
  VENDOR
}

enum ClassGroup {
  CAMBRIDGE
  HOMESCHOOL
  PLUS
  STAFF
}

enum MealType {
  BREAKFAST
  LUNCH
  BRUNCH
}

/// CHEF = "Chef's Choice", vendor decides the dish.
/// CUSTOM = parent picked a specific MenuItem.
enum SelectionMode {
  CHEF
  CUSTOM
}

enum BlockKind {
  HOLIDAY
  BREAK
}

/// How a plan's price is derived.
/// PER_DAY_RATE  — flat rate charged for each ordered day (chefs_bf, chefs_ln, chefs_both)
/// PER_STUDY_DAY — promo rate × every available study day in the cycle (chefs_set_daily)
enum PlanPricing {
  PER_DAY_RATE
  PER_STUDY_DAY
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CANCELLED
  PAID
}

/// Who made a change to an order day. Kept separate from Role because a
/// change can also be made by the system (a cut-off passing, an import).
enum ChangeActor {
  PARENT
  ADMIN
  VENDOR
  SYSTEM
}

/// PARENT — what the school charges a family.
/// SCHOOL — what the vendor charges the school.
/// Both are drawn from the same OrderDay rows, seen from opposite sides.
enum InvoiceParty {
  PARENT
  SCHOOL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

/// Where an order came from. The UI already distinguishes these — the vendor
/// calendar badges a day "Actual orders" or "Sample data", the billing table
/// marks rows "via portal" — so provenance has to survive into the database or
/// those labels become lies.
///
/// PARENT_PORTAL — placed by a parent in /parent/order.
/// SERVICE_SHEET — imported from the school's vendor name list; the record of
///                 what was actually served.
/// IMPORTED_FORM — read out of a Google Form response export.
/// SAMPLE        — generated stand-in data. Must never reach an invoice.
enum OrderSource {
  PARENT_PORTAL
  SERVICE_SHEET
  IMPORTED_FORM
  SAMPLE
}

// ── People ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PARENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students        Student[]
  orders          Order[]              @relation("OrderParent")
  cancelledOrders Order[]              @relation("OrderCancelledBy")
  sessions        Session[]
  dayChanges      OrderDayChange[]
  sheetImports    ServiceSheetImport[]
}

/// Server-side sessions. The cookie holds this id, never the user id.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Student {
  id          String     @id @default(cuid())
  name        String
  classGroup  ClassGroup
  year        String?
  /// Standing allergy flags, e.g. ["peanuts", "noSpicy"]. Keys match ALLERGY_LABELS.
  allergies   String[]   @default([])
  /// The parent's exact wording. The chips above are a best-effort match, and
  /// "Broad Bean (G6PD)", "Aloe vera" and "no beef" match no chip at all — so
  /// dropping this text would drop the warning.
  allergyNote String?
  parentId    String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent       User?                @relation(fields: [parentId], references: [id], onDelete: SetNull)
  orders       Order[]
  invoices     Invoice[]
  declarations AllergyDeclaration[]

  @@index([parentId])
  @@index([classGroup])
}

/// An allergy declared on a form response that could not be matched to a
/// student — the response carries a class and a timestamp but no readable
/// name. Three exist for September 2026, including a peanut allergy.
///
/// These are deliberately NOT folded into Student: an unmatched warning must
/// stay visible as unmatched, so the kitchen knows it applies to someone in
/// that class it cannot yet identify.
model AllergyDeclaration {
  id                String     @id @default(cuid())
  /// Form submission time — the only handle on which response this was.
  submittedAt       DateTime
  classGroup        ClassGroup
  year              String?
  allergies         String[]   @default([])
  note              String
  resolvedStudentId String?
  resolvedAt        DateTime?
  createdAt         DateTime   @default(now())

  resolvedStudent Student? @relation(fields: [resolvedStudentId], references: [id], onDelete: SetNull)

  @@index([resolvedStudentId])
  @@index([classGroup])
}

// ── Catalogue ─────────────────────────────────────────────────────────────────

model MenuItem {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  mealType    MealType
  vendorCost  Decimal  @db.Decimal(10, 2)
  parentPrice Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings  MenuOffering[]
  orderMeals OrderMeal[]

  @@index([mealType])
}

/// Which items are on offer for a given date + meal. Replaces MENU_BY_DATE.
model MenuOffering {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  mealType   MealType
  menuItemId String
  sortOrder  Int      @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([date, mealType, menuItemId])
  @@index([date])
}

/// Dates a class group cannot order for. Replaces BLOCKED_DATES.
model CalendarBlock {
  id         String     @id @default(cuid())
  date       DateTime   @db.Date
  classGroup ClassGroup
  kind       BlockKind
  name       String

  @@unique([date, classGroup])
  @@index([classGroup])
}

/// Chef's Choice plans. Replaces CHEFS_PRICING.
model PlanOption {
  id          String      @id @default(cuid())
  code        String      @unique
  label       String
  note        String
  vendorCost  Decimal     @db.Decimal(10, 2)
  parentPrice Decimal     @db.Decimal(10, 2)
  pricing     PlanPricing @default(PER_DAY_RATE)
  active      Boolean     @default(true)

  orders Order[]
}

/// Tunables that would otherwise be magic numbers in the UI,
/// e.g. combo_discount = "1.00".
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Which meals a class group may order at all.
///
/// This is where the order form's "Zera PLUS students are eligible for
/// Breakfast only" rule lives. It exists nowhere in the codebase today, so it
/// cannot be rediscovered by reading it — as data it can at least be seen and
/// enforced.
model ClassGroupRule {
  classGroup   ClassGroup @id
  allowedMeals MealType[]
  note         String?
  updatedAt    DateTime   @updatedAt
}

/// One vendor name list loaded into the system.
///
/// The vendor calendar labels a day "Actual orders" or "Sample data", and that
/// badge has to be answerable: this says which sheet a day's orders came from,
/// when it was loaded and how many rows it carried. Without it, "actual" is
/// just a colour.
model ServiceSheetImport {
  id             String   @id @default(cuid())
  /// The serving date the sheet covers.
  serviceDate    DateTime @db.Date
  /// File the rows were read from, e.g. "Meal Plan Name List - 14SeptemberREV01.pdf".
  sourceName     String
  /// Revision printed on the sheet, where it has one ("REV01").
  revision       String?
  breakfastRows  Int      @default(0)
  lunchRows      Int      @default(0)
  brunchRows     Int      @default(0)
  /// Names on the sheet that matched no student, for follow-up.
  unmatchedNames String[] @default([])
  importedAt     DateTime @default(now())
  importedById   String?

  importedBy User? @relation(fields: [importedById], references: [id], onDelete: SetNull)

  @@unique([serviceDate, sourceName])
  @@index([serviceDate])
}

// ── Ordering ──────────────────────────────────────────────────────────────────

/// One orderable month. Replaces the hardcoded June 2026.
model OrderCycle {
  id       String      @id @default(cuid())
  year     Int
  month    Int
  status   CycleStatus @default(DRAFT)
  opensAt  DateTime?
  closesAt DateTime?

  /// How late a placed order may still be changed, as CLEAR days before the
  /// meal: 2 means a meal on the 13th stops being editable at 22:00 on the
  /// 10th. Held here rather than in lib/cutoff.js so the school can move the
  /// deadline without a deploy.
  changeCutoffDays Int @default(2)
  changeCutoffHour Int @default(22)

  orders   Order[]
  invoices Invoice[]

  @@unique([year, month])
}

model Order {
  id         String      @id @default(cuid())
  cycleId    String
  studentId  String
  parentId   String?
  classGroup ClassGroup
  /// Null means "I'll choose" — the parent picked dishes per date rather than
  /// taking a Chef's Choice plan.
  planId     String?
  status     OrderStatus @default(DRAFT)
  source     OrderSource @default(PARENT_PORTAL)

  /// Snapshotted at submit. Never recomputed from current prices.
  subtotal Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  /// What was declared at order time — the vendor reads this, not Student.allergies.
  allergies   String[] @default([])
  allergyNote String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  /// Admins cancel on a parent's request. Status alone cannot answer "who
  /// cancelled my order, and when" — which is the question that actually gets
  /// asked once money is involved.
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  cycle       OrderCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent      User?       @relation("OrderParent", fields: [parentId], references: [id], onDelete: SetNull)
  cancelledBy User?       @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  plan        PlanOption? @relation(fields: [planId], references: [id])
  days        OrderDay[]

  @@unique([cycleId, studentId])
  @@index([parentId])
  @@index([status])
  @@index([source])
}

/// One ordered date. Pricing lives here because calcChild() prices per date:
/// a chef_both day is one RM 10.00 line covering two meals, and the combo
/// discount is a property of the day, not of either meal.
model OrderDay {
  id       String   @id @default(cuid())
  orderId  String
  date     DateTime @db.Date
  price    Decimal  @db.Decimal(10, 2)
  discount Decimal  @default(0) @db.Decimal(10, 2)

  /// When this day passed its cut-off. A locked day survives a re-order
  /// instead of vanishing from it — the kitchen is already committed to it.
  lockedAt DateTime?

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meals        OrderMeal[]
  changes      OrderDayChange[]
  invoiceLines InvoiceLine[]

  @@unique([orderId, date])
  @@index([date])
}

/// Who changed one day of an order, and to what.
///
/// Parents change single days and admins cancel whole months. When a family
/// disputes a bill this is the only record that can answer what was ordered
/// and when it changed — the OrderDay itself only ever shows its final state.
model OrderDayChange {
  id          String      @id @default(cuid())
  orderDayId  String
  changedById String?
  actorRole   ChangeActor
  changedAt   DateTime    @default(now())
  /// Meal slots as they stood before and after, so a day can be reconstructed
  /// without replaying every row.
  before      Json?
  after       Json?
  reason      String?

  orderDay  OrderDay @relation(fields: [orderDayId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderDayId])
  @@index([changedAt])
}

/// What the student actually eats. The vendor dashboard reads this joined on date.
model OrderMeal {
  id         String        @id @default(cuid())
  orderDayId String
  mealType   MealType
  mode       SelectionMode
  menuItemId String?

  /// Frozen at submit so renaming or repricing a dish never rewrites history.
  itemNameSnapshot String?
  unitParentPrice  Decimal @db.Decimal(10, 2)
  unitVendorCost   Decimal @db.Decimal(10, 2)

  orderDay OrderDay  @relation(fields: [orderDayId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@unique([orderDayId, mealType])
}

// ── Billing ───────────────────────────────────────────────────────────────────
// The bill is currently recomputed from live orders on every page load. That is
// fine to look at and wrong to send: once an invoice dated 01/09/2026 has gone
// out, a parent editing one meal must not silently change what the school
// already charged. Issuing an invoice freezes its lines here.

model Invoice {
  id        String        @id @default(cuid())
  cycleId   String
  party     InvoiceParty
  /// The family being charged. Null on the SCHOOL invoice, which covers the
  /// whole cycle in one document.
  studentId String?
  number    String        @unique
  issuedAt  DateTime?
  dueAt     DateTime?
  total     Decimal       @default(0) @db.Decimal(10, 2)
  status    InvoiceStatus @default(DRAFT)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  cycle   OrderCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  student Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lines   InvoiceLine[]

  /// One invoice per party per student per cycle. Postgres treats NULLs as
  /// distinct, so this does not by itself stop a second SCHOOL invoice for a
  /// cycle — issuing code must check for one.
  @@unique([cycleId, party, studentId])
  @@index([status])
}

/// A frozen copy of one charge. Written when the invoice is issued and never
/// recomputed — that is the entire point of the table.
model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  /// Kept for traceability. SetNull rather than Cascade: deleting an order
  /// must never quietly delete a line off an invoice already sent.
  orderDayId  String?
  date        DateTime? @db.Date
  description String
  quantity    Int       @default(1)
  amount      Decimal   @db.Decimal(10, 2)

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderDay OrderDay? @relation(fields: [orderDayId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([orderDayId])
}
